const TEAMS_ORDER = ["green", "blue", "red"];

function shuffledIds(list) {
  const ids = list.map((p) => p.id);
  for (let i = ids.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [ids[i], ids[j]] = [ids[j], ids[i]];
  }
  return ids;
}

function freshState(purse) {
  const teams = {};
  TEAMS_ORDER.forEach((k) => {
    teams[k] = { purse, spent: 0, roster: [] };
  });
  return {
    phase: "setup",
    purseStart: purse,
    order: [],
    idx: 0,
    unsold: [],
    teams,
    history: [],
  };
}

// --- plain localStorage helpers (synchronous, no hangs, no race conditions) ---
function readLocal(key, fallback) {
  try {
    const raw = localStorage.getItem(key);
    return raw === null ? fallback : raw;
  } catch {
    return fallback;
  }
}
function writeLocal(key, value) {
  try {
    localStorage.setItem(key, value);
  } catch {
    // best effort only
  }
}

function App() {
  const [state, setState] = useState(() => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : freshState(100);
    } catch {
      return freshState(100);
    }
  });
  const [purseInput, setPurseInput] = useState(100);
  const [bidTeam, setBidTeam] = useState(null);
  const [bidAmount, setBidAmount] = useState("");
  const [soldFlash, setSoldFlash] = useState(null);
  const [error, setError] = useState("");
  const [unlocked, setUnlocked] = useState(() => readLocal(LOCK_KEY, "no") === "yes");
  const [pinInput, setPinInput] = useState("");
  const [pinError, setPinError] = useState("");
  const [showResetConfirm, setShowResetConfirm] = useState(false);

  function tryUnlock() {
    if (pinInput === AUCTION_PIN) {
      setPinError("");
      setUnlocked(true);
      writeLocal(LOCK_KEY, "yes");
    } else {
      setPinError("Wrong code — try again.");
    }
  }

  function lockAgain() {
    setUnlocked(false);
    setPinInput("");
    writeLocal(LOCK_KEY, "no");
  }

  const persist = useCallback((next) => {
    setState(next);
    writeLocal(STORAGE_KEY, JSON.stringify(next));
  }, []);

  if (!unlocked) {
    return (
      <div style={S.appShell}>
        <style>{CSS}</style>
        <div style={S.floodTop} />
        <div style={{ ...S.container, maxWidth: 380, paddingTop: 60 }}>
          <header style={S.header}>
            <div style={S.eyebrow}>KATL · WEEKEND LEAGUE</div>
            <h1 style={S.title}>AUCTION NIGHT</h1>
            <div style={S.subtitle}>Enter the code to open the auction</div>
          </header>
          <div style={S.setupCard}>
            <input
              type="password"
              inputMode="numeric"
              placeholder="Enter code"
              value={pinInput}
              onChange={(e) => setPinInput(e.target.value)}
              onKeyDown={(e) => e.key === "Enter" && tryUnlock()}
              style={{ ...S.purseInput, width: "100%", textAlign: "center", fontSize: 20, letterSpacing: 4, marginBottom: 14 }}
              autoFocus
            />
            <button style={S.primaryBtn} onClick={tryUnlock}>
              <span style={{ marginRight: 8 }}>✓</span> Unlock
            </button>
            {pinError && <div style={{ ...S.errorText, textAlign: "center", marginTop: 12 }}>{pinError}</div>}
          </div>
        </div>
      </div>
    );
  }

  const currentPlayer =
    state.phase === "auction" && state.idx < state.order.length
      ? POOL.find((p) => p.id === state.order[state.idx])
      : null;

  function startAuction() {
    const purse = Math.max(10, Number(purseInput) || 100);
    const order = shuffledIds(POOL);
    persist({ ...freshState(purse), phase: "auction", order });
  }

  function resetAll() {
    setShowResetConfirm(true);
  }

  function confirmReset() {
    persist(freshState(state.purseStart || 100));
    setBidTeam(null);
    setBidAmount("");
    setShowResetConfirm(false);
  }

  function goNext(s) {
    const nextIdx = s.idx + 1;
    if (nextIdx >= s.order.length) {
      if (s.unsold.length > 0) {
        return { ...s, order: [...s.order, ...shuffledIds(s.unsold.map((id) => POOL.find((p) => p.id === id)))], unsold: [], idx: nextIdx };
      }
      return { ...s, idx: nextIdx };
    }
    return { ...s, idx: nextIdx };
  }

  function confirmSale() {
    setError("");
    if (!currentPlayer || !bidTeam) {
      setError("Pick a team first.");
      return;
    }
    const price = Number(bidAmount);
    if (!price || price <= 0) {
      setError("Enter a valid sale price.");
      return;
    }
    const team = state.teams[bidTeam];
    if (price > team.purse) {
      setError(`${TEAM_META[bidTeam].label} only has ${team.purse} left.`);
      return;
    }
    const nextTeams = {
      ...state.teams,
      [bidTeam]: {
        ...team,
        purse: team.purse - price,
        spent: team.spent + price,
        roster: [...team.roster, { ...currentPlayer, price }],
      },
    };
    const history = [...state.history, { type: "sale", team: bidTeam, player: currentPlayer, price }];
    const advanced = goNext({ ...state, teams: nextTeams, history });
    persist(advanced);
    setSoldFlash({ name: currentPlayer.name, team: bidTeam });
    setTimeout(() => setSoldFlash(null), 1100);
    setBidTeam(null);
    setBidAmount("");
  }

  function markUnsold() {
    if (!currentPlayer) return;
    const history = [...state.history, { type: "unsold", player: currentPlayer }];
    const withUnsold = { ...state, unsold: [...state.unsold, currentPlayer.id], history };
    persist(goNext(withUnsold));
    setBidTeam(null);
    setBidAmount("");
    setError("");
  }

  function undoLast() {
    const h = state.history;
    if (h.length === 0) return;
    const last = h[h.length - 1];
    if (last.type === "sale") {
      const team = state.teams[last.team];
      const nextTeams = {
        ...state.teams,
        [last.team]: {
          ...team,
          purse: team.purse + last.price,
          spent: team.spent - last.price,
          roster: team.roster.filter((r) => r.id !== last.player.id),
        },
      };
      persist({ ...state, teams: nextTeams, idx: state.idx - 1, history: h.slice(0, -1) });
    } else if (last.type === "unsold") {
      persist({ ...state, unsold: state.unsold.filter((id) => id !== last.player.id), idx: state.idx - 1, history: h.slice(0, -1) });
    }
  }

  function exportToExcel() {
    const wb = XLSX.utils.book_new();

    const summaryRows = [["Team", "Captain", "Purse Used", "Purse Left", "Players"]];
    TEAMS_ORDER.forEach((k) => {
      const team = state.teams[k];
      summaryRows.push([
        TEAM_META[k].label,
        CAPTAINS[k].name,
        team.spent,
        team.purse,
        team.roster.length + 1,
      ]);
    });
    const summarySheet = XLSX.utils.aoa_to_sheet(summaryRows);
    XLSX.utils.book_append_sheet(wb, summarySheet, "Summary");

    TEAMS_ORDER.forEach((k) => {
      const team = state.teams[k];
      const rows = [["Player", "Role", "Price"]];
      rows.push([CAPTAINS[k].name + " (C)", CAPTAINS[k].role, "—"]);
      team.roster.forEach((r) => rows.push([r.name, r.role, r.price]));
      const sheet = XLSX.utils.aoa_to_sheet(rows);
      XLSX.utils.book_append_sheet(wb, sheet, TEAM_META[k].label.replace("Team ", ""));
    });

    if (state.unsold.length > 0) {
      const rows = [["Player", "Role"]];
      state.unsold.forEach((id) => {
        const p = POOL.find((pl) => pl.id === id);
        if (p) rows.push([p.name, p.role]);
      });
      const sheet = XLSX.utils.aoa_to_sheet(rows);
      XLSX.utils.book_append_sheet(wb, sheet, "Unsold");
    }

    const statsRows = [[
      "Player", "Mat", "Inn", "Runs", "HS", "Avg", "SR", "50s", "100s", "Ducks",
      "Bowl Inn", "Overs", "Wkts", "Econ", "Bowl Avg", "Bowl SR", "Best",
    ]];
    POOL.forEach((p) => {
      if (!p.stats) return;
      const s = p.stats;
      statsRows.push([p.name, s.mat, s.inn, s.runs, s.hs, s.avg, s.sr, s.fifties, s.hundreds, s.ducks, s.bowlInn, s.overs, s.wkts, s.econ, s.bowlAvg, s.bowlSr, s.best]);
    });
    TEAMS_ORDER.forEach((k) => {
      const s = CAPTAINS[k].stats;
      if (!s) return;
      statsRows.push([CAPTAINS[k].name + " (C)", s.mat, s.inn, s.runs, s.hs, s.avg, s.sr, s.fifties, s.hundreds, s.ducks, s.bowlInn, s.overs, s.wkts, s.econ, s.bowlAvg, s.bowlSr, s.best]);
    });
    const statsSheet = XLSX.utils.aoa_to_sheet(statsRows);
    XLSX.utils.book_append_sheet(wb, statsSheet, "Career Stats");

    XLSX.writeFile(wb, "KATL-Auction-Results.xlsx");
  }

  const soldCount = TEAMS_ORDER.reduce((acc, k) => acc + state.teams[k].roster.length, 0);
  const remaining = Math.max(0, state.order.length - state.idx);
  const isComplete = state.phase === "auction" && state.idx >= state.order.length && state.unsold.length === 0;

  return (
    <div style={S.appShell}>
      <style>{CSS}</style>
      <div style={S.floodTop} />
      <div style={S.container}>
        <header style={S.header}>
          <div style={S.eyebrow}>KATL · WEEKEND LEAGUE</div>
          <h1 style={S.title}>AUCTION NIGHT</h1>
          <div style={S.subtitle}>Live player draft — one screen, three captains, one purse each</div>
          <button style={{ ...S.ghostBtn, margin: "14px auto 0" }} onClick={lockAgain}>
            Lock screen
          </button>
        </header>

        {state.phase === "setup" && (
          <div style={S.setupCard}>
            <div style={S.setupRow}>
              <span style={{ fontSize: 18 }}>👥</span>
              <span style={{ color: S.colors.textMuted, fontFamily: S.fonts.body }}>
                {POOL.length} players in the pool · 3 captains locked in already
              </span>
            </div>
            <div style={S.captainRow}>
              {TEAMS_ORDER.map((k) => (
                <div key={k} style={{ ...S.captainChip, borderColor: TEAM_META[k].accent }}>
                  <div style={{ ...S.dot, background: TEAM_META[k].accent }} />
                  <div>
                    <div style={S.captainName}>{CAPTAINS[k].name}</div>
                    <div style={S.captainSub}>{TEAM_META[k].label} · {CAPTAINS[k].role}</div>
                  </div>
                </div>
              ))}
            </div>
            <div style={S.purseSetup}>
              <label style={S.purseLabel}>Purse per team (credits)</label>
              <input
                type="number"
                value={purseInput}
                onChange={(e) => setPurseInput(e.target.value)}
                style={S.purseInput}
                min={10}
              />
            </div>
            <button style={S.primaryBtn} onClick={startAuction}>
              <span style={{ marginRight: 8 }}>🔀</span>
              Shuffle pool &amp; begin auction
            </button>
          </div>
        )}

        {state.phase === "auction" && !isComplete && currentPlayer && (
          <React.Fragment>
            <div style={S.progressBar}>
              <div style={{ ...S.progressFill, width: `${(soldCount / POOL.length) * 100}%` }} />
              <span style={S.progressText}>
                {soldCount}/{POOL.length} sold · {remaining} left in this round
                {state.unsold.length > 0 ? ` · ${state.unsold.length} pending re-auction` : ""}
              </span>
            </div>

            <div style={S.blockWrap}>
              <div style={S.spotlight} />
              <div style={S.blockCard} key={currentPlayer.id}>
                <div style={S.onBlockLabel}>ON THE BLOCK</div>
                <div style={S.playerName}>{currentPlayer.name}</div>
                <div style={S.playerMeta}>
                  <span style={S.roleTag}>{currentPlayer.role}</span>
                </div>

                {currentPlayer.stats ? (
                  <div style={S.statsGrid}>
                    <div style={S.statsCol}>
                      <div style={S.statsColHead}>Batting</div>
                      <div style={S.statLine}><span>Matches</span><span>{currentPlayer.stats.mat}</span></div>
                      <div style={S.statLine}><span>Runs</span><span>{currentPlayer.stats.runs}</span></div>
                      <div style={S.statLine}><span>Average</span><span>{currentPlayer.stats.avg}</span></div>
                      <div style={S.statLine}><span>Strike rate</span><span>{currentPlayer.stats.sr}</span></div>
                      <div style={S.statLine}><span>HS</span><span>{currentPlayer.stats.hs}</span></div>
                      <div style={S.statLine}><span>50s / 100s</span><span>{currentPlayer.stats.fifties} / {currentPlayer.stats.hundreds}</span></div>
                    </div>
                    <div style={S.statsCol}>
                      <div style={S.statsColHead}>Bowling</div>
                      <div style={S.statLine}><span>Innings</span><span>{currentPlayer.stats.bowlInn}</span></div>
                      <div style={S.statLine}><span>Overs</span><span>{currentPlayer.stats.overs}</span></div>
                      <div style={S.statLine}><span>Wickets</span><span>{currentPlayer.stats.wkts}</span></div>
                      <div style={S.statLine}><span>Economy</span><span>{currentPlayer.stats.econ}</span></div>
                      <div style={S.statLine}><span>Bowl avg</span><span>{currentPlayer.stats.bowlAvg}</span></div>
                      <div style={S.statLine}><span>Best</span><span>{currentPlayer.stats.best}</span></div>
                    </div>
                  </div>
                ) : (
                  <div style={S.statsMissing}>No CricHeroes stats on file for this player.</div>
                )}

                <div style={S.teamPickRow}>
                  {TEAMS_ORDER.map((k) => (
                    <button
                      key={k}
                      onClick={() => setBidTeam(k)}
                      style={{
                        ...S.teamPickBtn,
                        borderColor: TEAM_META[k].accent,
                        background: bidTeam === k ? TEAM_META[k].accent : "transparent",
                        color: bidTeam === k ? "#0A1128" : TEAM_META[k].accent,
                      }}
                    >
                      {TEAM_META[k].label.replace("Team ", "")}
                      <span style={S.pursePill}>{state.teams[k].purse} left</span>
                    </button>
                  ))}
                </div>

                <div style={S.saleRow}>
                  <input
                    type="number"
                    placeholder="Sale price"
                    value={bidAmount}
                    onChange={(e) => setBidAmount(e.target.value)}
                    style={S.saleInput}
                  />
                  <button style={S.soldBtn} onClick={confirmSale} disabled={!bidTeam}>
                    <span style={{ marginRight: 6 }}>✓</span> SOLD
                  </button>
                  <button style={S.unsoldBtn} onClick={markUnsold}>
                    <span style={{ marginRight: 6 }}>✕</span> Unsold
                  </button>
                </div>
                {error && <div style={S.errorText}>{error}</div>}
              </div>
            </div>

            <div style={S.undoRow}>
              <button style={S.ghostBtn} onClick={undoLast} disabled={state.history.length === 0}>
                <span style={{ marginRight: 6 }}>↩</span> Undo last
              </button>
              <button style={S.ghostBtn} onClick={resetAll}>
                <span style={{ marginRight: 6 }}>↺</span> Reset auction
              </button>
              <button style={S.ghostBtn} onClick={exportToExcel}>
                <span style={{ marginRight: 6 }}>⬇</span> Export so far
              </button>
            </div>
          </React.Fragment>
        )}

        {isComplete && (
          <div style={S.completeWrap}>
            <div style={S.completeHeader}>
              <span style={{ fontSize: 22 }}>🏆</span>
              <span style={S.completeTitle}>AUCTION COMPLETE</span>
            </div>
            <div style={{ display: "flex", gap: 10, justifyContent: "center", marginBottom: 20 }}>
              <button style={S.primaryBtnSmall} onClick={exportToExcel}>
                <span style={{ marginRight: 6 }}>⬇</span> Download final teams (Excel)
              </button>
              <button style={S.ghostBtn} onClick={resetAll}>
                <span style={{ marginRight: 6 }}>↺</span> Start a new auction
              </button>
            </div>
          </div>
        )}

        {(state.phase === "auction") && (
          <div style={S.teamsGrid}>
            {TEAMS_ORDER.map((k) => {
              const team = state.teams[k];
              const purseUsedPct = ((state.purseStart - team.purse) / state.purseStart) * 100;
              return (
                <div key={k} style={{ ...S.teamCard, borderColor: TEAM_META[k].accent }}>
                  <div style={S.teamCardHead}>
                    <div style={{ ...S.dot, background: TEAM_META[k].accent }} />
                    <div style={S.teamCardTitle}>{TEAM_META[k].label}</div>
                  </div>
                  <div style={S.teamStatRow}>
                    <span style={S.teamStatLabel}>Purse left</span>
                    <span style={{ ...S.teamStatValue, color: TEAM_META[k].accent }}>{team.purse}</span>
                  </div>
                  <div style={S.gaugeTrack}>
                    <div style={{ ...S.gaugeFill, width: `${purseUsedPct}%`, background: TEAM_META[k].accent }} />
                  </div>
                  <ul style={S.rosterList}>
                    <li style={S.rosterCaptainRow}>
                      <span>{CAPTAINS[k].name} (C)</span>
                      <span style={S.rosterCaptainTag}>captain</span>
                    </li>
                    {team.roster.map((r) => (
                      <li key={r.id} style={S.rosterRow}>
                        <span>{r.name}</span>
                        <span style={S.rosterPrice}>{r.price}</span>
                      </li>
                    ))}
                    {team.roster.length === 0 && <li style={S.rosterEmpty}>No players yet</li>}
                  </ul>
                </div>
              );
            })}
          </div>
        )}
      </div>

      {soldFlash && (
        <div style={S.stampOverlay}>
          <div style={{ ...S.stamp, borderColor: TEAM_META[soldFlash.team].accent, color: TEAM_META[soldFlash.team].accent }}>
            SOLD
          </div>
        </div>
      )}

      {showResetConfirm && (
        <div style={S.confirmOverlay}>
          <div style={S.confirmCard}>
            <div style={S.confirmTitle}>Reset the whole auction?</div>
            <div style={S.confirmBody}>This clears every sale, every purse, and every roster. This can't be undone.</div>
            <div style={S.confirmRow}>
              <button style={S.confirmCancelBtn} onClick={() => setShowResetConfirm(false)}>
                Cancel
              </button>
              <button style={S.confirmDangerBtn} onClick={confirmReset}>
                Yes, reset
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

